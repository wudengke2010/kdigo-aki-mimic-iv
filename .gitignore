# Ignore raw MIMIC-IV data (must be downloaded separately from PhysioNet)
*.csv
*.csv.gz
*.db
*.sqlite
*.parquet

# Ignore large intermediate files
__pycache__/
*.pyc
*.pkl
*.h5

# Ignore WorkBuddy/memory (project-specific)
.workbuddy/memory/

# Ignore manuscript drafts and local notes (not part of code repo)
*.docx
*.md
!README.md
!LICENSE

# Keep Python analysis scripts and result files
!*.py
!*.json
!requirements.txt

# Keep key result files under results/
!results/*.csv
!results/*.json
