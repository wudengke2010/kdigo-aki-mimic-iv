# Ignore raw MIMIC-IV data (must be downloaded separately from PhysioNet)
*.csv
*.csv.gz
*.db
*.sqlite
*.parquet

# Ignore large intermediate files
__pycache__/
*.pyc
*.pkl
*.h5

# Ignore WorkBuddy/memory (project-specific)
.workbuddy/memory/

# Ignore manuscript drafts and local notes (not part of code repo)
*.docx
*.md
!README.md
!LICENSE

# Exception: keep CKJ submission manuscript and supplementary files
!manuscript_ckj_submission.md
!manuscript_ckj_submission.docx
!cover_letter_ckj.md
!ckj_submission_checklist.md
!ckj_submission_assessment.md
!manuscript_revised_v3.md
!manuscript_dual_cohort_v12.docx

# Keep Python analysis scripts and result files
!*.py
!*.json
!requirements.txt

# Keep key result files under results/
!results/*.csv
!results/*.json

# Ignore matplotlib cache and config
.matplotlib/
.matplotlib_cache/
.mpl_cache/
.mplconfig/

# Ignore font cache
fontlist-*.json
fontlist-*.json.*

# Ignore log files
*.log

# Ignore intermediate/draft files
*.drawio
*.dot
paper_summary.txt
kdigo_dashboard*.html

# Ignore benchmark extraction files
bench_*.txt
bench_nonrenal/

# Ignore WorkBuddy local state
.workbuddy/

# Exception: JTM submission package (transparency of submitted version)
!jtm_submission/manuscript_jtm.md
!jtm_submission/cover_letter_jtm.md
!jtm_submission/strobe_checklist_jtm.docx
!journal_recommendations_v2.md
*.err
!jtm_submission/manuscript_jtm.docx
!jtm_submission/submission_guide_jtm.md
!manuscript_revised_v5.md
